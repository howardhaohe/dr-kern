# Default: normalize all text files to LF in git database
* text=auto eol=lf

# Explicit text overrides
*.py text eol=lf
*.ipynb text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary overrides (never alter binary line breaks)
*.png binary
*.jpg binary
*.jpeg binary
*.parquet binary
*.pkl binary
*.joblib binary
*.zip binary
*.gz binary
*.tar binary